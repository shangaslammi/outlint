      "reason": "RFC 9535 int forbids -0"
    },
    {
      "name": "one beyond the positive I-JSON boundary",
      "selector": "$.tags[9007199254740992]",
      "reason": "specification 4.6 bounds core index selectors to the I-JSON exact range"
    },
